{
  "name": "@configkits/mcp-schema-validator",
  "version": "0.1.0",
  "description": "Runtime schema validation middleware for MCP tool inputs and outputs. Compatible with Zod, Valibot, ArkType.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "validation",
    "middleware",
    "zod",
    "valibot",
    "arktype",
    "typescript",
    "llm",
    "ai",
    "configkits"
  ],
  "author": "Riyajath Ahamed <riyajath@configkits.dev>",
  "license": "MIT",
  "homepage": "https://configkits.dev/mcp-schema-validator",
  "repository": {
    "type": "git",
    "url": "https://github.com/configkits/mcp-schema-validator"
  },
  "bugs": {
    "url": "https://github.com/configkits/mcp-schema-validator/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "doc",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "dev": "tsup src/index.ts --format esm,cjs --dts --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build && npm run test && npm run typecheck"
  },
  "peerDependencies": {
    "@standard-schema/spec": "^1.0.0"
  },
  "peerDependenciesMeta": {
    "zod": { "optional": true },
    "valibot": { "optional": true },
    "arktype": { "optional": true }
  },
  "devDependencies": {
    "@standard-schema/spec": "^1.0.0",
    "@types/node": "^20.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "vitest": "^1.0.0",
    "zod": "^3.23.0",
    "valibot": "^0.31.0"
  },
  "engines": {
    "node": ">=18"
  }
}
